/* =========================================================
   Base
   ========================================================= */

QMainWindow {
    background-color: #111014;
}

QWidget {
    color: #e6e3ea;
    font-family: "Inter";
    font-size: 13px;
}


/* =========================================================
   Header
   ========================================================= */

#logo {
    color: #b39ad8;
    font-size: 20px;
    font-weight: 600;
}

#settingsButton {
    background-color: #1a181e;
    color: #aaa3b3;

    border: 1px solid #2b2830;
    border-radius: 8px;

    padding: 7px 11px;

    font-size: 12px;
}

#settingsButton:hover {
    background-color: #211e26;
    color: #c5b4df;
    border-color: #3a3342;
}

#settingsButton:pressed {
    background-color: #26212d;
}


/* =========================================================
   Page title
   ========================================================= */

#pageTitle {
    color: #f0edf2;

    font-size: 24px;
    font-weight: 600;

    margin-top: 20px;
    margin-bottom: 8px;
}


/* =========================================================
   Main cards
   ========================================================= */

#card {
    background-color: #18161b;

    border: 1px solid #29262e;
    border-radius: 12px;

    padding: 16px;
}


/* =========================================================
   Buttons
   ========================================================= */

#primaryButton {
    background-color: #73559a;
    color: #ffffff;

    border: none;
    border-radius: 8px;

    padding: 8px 14px;

    font-size: 13px;
    font-weight: 500;
}

#primaryButton:hover {
    background-color: #8062a8;
}

#primaryButton:pressed {
    background-color: #674b8b;
}


#secondaryButton {
    background-color: #1d1a21;
    color: #b7a4ca;

    border: 1px solid #332d3a;
    border-radius: 8px;

    padding: 7px 12px;

    font-size: 13px;
    font-weight: 500;
}

#secondaryButton:hover {
    background-color: #25202b;
    color: #c7b6d8;
    border-color: #42394c;
}

#secondaryButton:pressed {
    background-color: #2b2433;
}


#productCard {
    background-color: #18161b;
    border: 1px solid #29262e;
    border-radius: 9px;
}

#productName {
    color: #e8e4eb;
    font-size: 14px;
    font-weight: 600;
}

#deleteButton {
    background-color: transparent;
    color: #77727e;
    border: none;
    padding: 0;
    font-size: 16px;
    font-weight: 500;
}

#deleteButton:hover {
    color: #c87888;
}

#statCard {
    background-color: #211e25;
    border: 1px solid #302c35;
    border-radius: 6px;
}

#statTitle {
    color: #85808a;
    font-size: 10px;
    font-weight: 500;
}

#statValue {
    color: #c1b5cc;
    font-size: 13px;
    font-weight: 600;
}


/* =========================================================
   Totals
   ========================================================= */

#totalCarbs,
#totalBreadUnits {
    background-color: #18161b;

    border: 1px solid #29262e;
    border-radius: 9px;

    padding: 10px 14px;

    color: #d9d4dd;

    font-size: 13px;
    font-weight: 500;
}

#totalCarbs {
    color: #b59bcf;
}

#totalBreadUnits {
    color: #ad94c9;
}


/* =========================================================
   Scroll area
   ========================================================= */

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}


/* =========================================================
   Scroll bar
   ========================================================= */

QScrollBar:vertical {
    background: transparent;

    width: 7px;

    margin: 2px 1px;
}

QScrollBar::handle:vertical {
    background: #3b3542;

    border-radius: 3px;

    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: #554a60;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;

    background: transparent;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}


/* =========================================================
   Inputs
   ========================================================= */

QLineEdit {
    background-color: #1b191f;
    color: #e6e3ea;

    border: 1px solid #302c35;
    border-radius: 7px;

    padding: 7px 9px;

    selection-background-color: #60477b;
}

QLineEdit:focus {
    border: 1px solid #735b8c;
    background-color: #1e1b22;
}

QLineEdit::placeholder {
    color: #716c76;
}


/* =========================================================
   Product dialog
   ========================================================= */

#productDialog {
    background-color: #111014;
}

#productInput {
    background-color: #1b191f;
    color: #e6e3ea;

    border: 1px solid #302c35;
    border-radius: 7px;

    padding: 8px 10px;

    font-size: 13px;
}

#productInput:focus {
    border: 1px solid #735b8c;
    background-color: #1e1b22;
}

#productInput::placeholder {
    color: #716c76;
}

#dialogAddButton {
    background-color: #73559a;
    color: #ffffff;

    border: none;
    border-radius: 8px;

    padding: 8px 13px;

    font-size: 13px;
    font-weight: 500;

    margin-bottom: 6px;
}

#dialogAddButton:hover {
    background-color: #8062a8;
}

#dialogAddButton:pressed {
    background-color: #674b8b;
}

#dialogCancelButton {
    background-color: #1d1a21;
    color: #b7a4ca;

    border: 1px solid #332d3a;
    border-radius: 8px;

    padding: 7px 13px;

    font-size: 13px;
}

#dialogCancelButton:hover {
    background-color: #25202b;
    color: #c7b6d8;
}

#dialogCancelButton:pressed {
    background-color: #2b2433;
}


/* =========================================================
   Settings panel
   ========================================================= */

#settingsPanel {
    background-color: #17151a;

    border: 1px solid #2c2931;
    border-radius: 12px;
}

#settingsTitle {
    color: #eeeaf0;

    font-size: 18px;
    font-weight: 600;
}


/* =========================================================
   Settings input
   ========================================================= */

#breadUnitsEqualsLabel {
    color: #918b96;

    font-size: 12px;
    font-weight: 500;
}

#breadUnitsEqualsEdit {
    background-color: #1c1a20;
    color: #e6e3ea;

    border: 1px solid #302c35;
    border-radius: 7px;

    padding: 6px 9px;

    min-height: 16px;
    max-width: 90px;

    font-size: 13px;
}

#breadUnitsEqualsEdit:focus {
    border: 1px solid #735b8c;
    background-color: #201c24;
}


/* =========================================================
   History
   ========================================================= */

#historyItem {
    background-color: #1c1a20;

    border: 1px solid #2d2932;
    border-radius: 8px;

    padding: 9px 10px;

    color: #ded9e1;

    font-size: 13px;
}

#historyItem:hover {
    background-color: #211e26;
    border-color: #393340;
}

/* =========================
   Page subtitle
   ========================= */

#pageSubtitle {
    color: #85808a;
    font-size: 12px;
    margin-bottom: 4px;
}


/* =========================
   Section titles
   ========================= */

#sectionTitle {
    color: #e6e2e9;
    font-size: 14px;
    font-weight: 600;
}


/* =========================
   Section descriptions
   ========================= */

#sectionDescription {
    color: #85808a;
    font-size: 12px;
}


/* =========================
   Image analysis
   ========================= */

#imageSection {
    background-color: #161419;
    border: 1px solid #29262e;
    border-radius: 10px;
}

#totalCarbs,
#totalBreadUnits {
    background-color: #1b191f;
    border: 1px solid #29262e;
    border-radius: 8px;
    padding: 9px 12px;
    font-size: 13px;
    font-weight: 500;
}

#totalCarbs {
    color: #b59bcf;
}

#totalBreadUnits {
    color: #aaa0b4;
}